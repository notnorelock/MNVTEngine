<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Authors>MNVTEngine contributors</Authors>
    <Copyright>Copyright (c) 2026 Norbert Podbiegły (Norelock)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Product>MNVTEngine</Product>
  </PropertyGroup>

  <!-- Engine versioning (docs/architecture/versioning.md): projects under src/ get the version of the build session
       from eng/Version.proj (Directory.Build.targets). MnvtVersionSession selects a pipeline build's session folder. -->
  <PropertyGroup>
    <MnvtVersioning Condition="'$(MnvtVersioning)' == '' and $([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/'))">true</MnvtVersioning>
    <MnvtVersionSession Condition="'$(MnvtVersionSession)' == ''">$(MNVT_VERSION_SESSION)</MnvtVersionSession>
  </PropertyGroup>

  <!-- eng/Version.proj builds the generator into artifacts/ with its own intermediate folder. -->
  <PropertyGroup Condition="'$(MnvtVersioningToolBuild)' == 'true'">
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/versioning-tool-obj/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- XML documentation for the engine assemblies, so game developers get IntelliSense tooltips for the gameplay
       API (CS1591/CS1573 off: documenting every public member is not required, only the ones that already are). -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/').StartsWith('src/Engine/'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Doc-quality notes (missing or imperfect cref/param tags) do not block; only CS1570 (malformed XML, which
         would corrupt the whole .xml) stays an error. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574;CS1571;CS1572;CS1711;CS1712;CS0419</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
