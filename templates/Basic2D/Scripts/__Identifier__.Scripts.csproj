<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game's C# components. Compiled by the editor, `mnvt run` and `mnvt build`; references the engine's gameplay API only. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="{{EngineRoot}}/src/Engine/MNVTEngine.Scenes/MNVTEngine.Scenes.csproj" Private="false" />
    <ProjectReference Include="{{EngineRoot}}/src/Engine/MNVTEngine.UI/MNVTEngine.UI.csproj" Private="false" />
  </ItemGroup>
</Project>
