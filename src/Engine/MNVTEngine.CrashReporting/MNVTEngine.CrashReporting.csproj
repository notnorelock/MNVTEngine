<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Crash reports for the engine's executables (exported games, Player, Editor). No engine dependencies: the crash
    handler process loads only this assembly. Windows: Win32 window, dumps through createdump and dbghelp.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StbImageSharp" />
    <PackageReference Include="StbImageWriteSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine wordmark (docs/images/mnvtengine-logo.svg) rendered dark for the white window; see CrashLogoTests. -->
    <EmbeddedResource Include="Resources\logo-dark.png" LogicalName="MNVTEngine.CrashReporting.logo-dark.png" />
  </ItemGroup>
</Project>
