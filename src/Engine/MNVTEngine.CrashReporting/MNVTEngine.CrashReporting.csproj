<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The in-process side of crash reporting for the engine's executables (exported games, Player, Editor): starts
    MNVTCrashHandler.exe (MNVTEngine.CrashHandler) to watch the process and tells it about crashes. No engine
    dependencies: the handler loads this assembly for the protocol.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
