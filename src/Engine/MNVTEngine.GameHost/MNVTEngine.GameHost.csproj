<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Executable of exported games. `mnvt build` publishes it per game, renamed to the game (MnvtGameName). It only runs
    packaged content: no compiler, no SDK, no editor.

    Layout: the apphost is framework-dependent but searches for .NET only in Dependencies/Runtime (AppRelative), where
    publishing places a private copy of the runtime from the runtime pack. The game therefore needs no installed .NET,
    and the root folder stays free of runtime files. Managed and native dependencies are moved to Dependencies/Managed
    and Dependencies/Native by the packager and resolved by HostLayout at startup.
  -->
  <PropertyGroup>
    <OutputType Condition="'$(MnvtConsole)' == 'false'">WinExe</OutputType>
    <OutputType Condition="'$(MnvtConsole)' != 'false'">Exe</OutputType>
    <AssemblyName Condition="'$(MnvtGameName)' != ''">$(MnvtGameName)</AssemblyName>
    <RootNamespace>MNVTEngine.GameHost</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained>false</SelfContained>
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
    <AppHostRelativeDotNet>Dependencies/Runtime</AppHostRelativeDotNet>
    <!-- In-game debug UI: on for Debug, off for Release unless the build passes MnvtDevTools=true (diagnostics.includeInRelease). -->
    <MnvtDevTools Condition="'$(MnvtDevTools)' == '' and '$(Configuration)' != 'Release'">true</MnvtDevTools>
    <DefineConstants Condition="'$(MnvtDevTools)' == 'true'">$(DefineConstants);MNVT_DEVTOOLS</DefineConstants>
    <!-- Game settings only concern this executable; engine libraries build the same for every game. -->
    <MnvtGameProperties>MnvtGameName;MnvtConsole;MnvtContentKey;MnvtDevTools;MnvtBootstrap</MnvtGameProperties>
  </PropertyGroup>
  <!-- mnvt build passes the game's generated module bootstrap (ModuleBootstrap.g.props): references to the modules the
       game uses and the code that creates them. Without it (development builds, tests) the host has every module. -->
  <Import Project="$(MnvtBootstrap)" Condition="'$(MnvtBootstrap)' != ''" />
  <ItemGroup>
    <AssemblyMetadata Include="MNVTEngine.ContentKey" Value="$(MnvtContentKey)" Condition="'$(MnvtContentKey)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MNVTEngine.CrashReporting\MNVTEngine.CrashReporting.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.GameAssemblies\MNVTEngine.GameAssemblies.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.Graphics.Vulkan\MNVTEngine.Graphics.Vulkan.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.Runtime\MNVTEngine.Runtime.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.DebugUI\MNVTEngine.DebugUI.csproj" Condition="'$(MnvtDevTools)' == 'true'" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
  </ItemGroup>
  <!-- Every module, for development builds; keep in step with ModuleBootstrap (MNVTEngine.Build), which a test checks. -->
  <ItemGroup Condition="'$(MnvtBootstrap)' == ''">
    <ProjectReference Include="..\MNVTEngine.Audio.OpenAL\MNVTEngine.Audio.OpenAL.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.Audio\MNVTEngine.Audio.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.Particles\MNVTEngine.Particles.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.Physics2D\MNVTEngine.Physics2D.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.Physics3D\MNVTEngine.Physics3D.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.Scripting.Bindings\MNVTEngine.Scripting.Bindings.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.Terrain.Components\MNVTEngine.Terrain.Components.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.UI\MNVTEngine.UI.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.World2D.Rendering\MNVTEngine.World2D.Rendering.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
    <ProjectReference Include="..\MNVTEngine.World3D.Rendering\MNVTEngine.World3D.Rendering.csproj" GlobalPropertiesToRemove="$(MnvtGameProperties)" />
  </ItemGroup>

  <!-- Private runtime in the layout of a .NET install (host/fxr + shared/Microsoft.NETCore.App), as hostfxr requires.
       The SDK restores the runtime pack for every RuntimeIdentifiers entry. -->
  <Target Name="MnvtPublishPrivateRuntime" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' != 'true'">
    <PropertyGroup>
      <MnvtRuntimePack>$(NuGetPackageRoot)microsoft.netcore.app.runtime.$(RuntimeIdentifier.ToLowerInvariant())/$(BundledNETCoreAppPackageVersion)/runtimes/$(RuntimeIdentifier)/</MnvtRuntimePack>
      <MnvtRuntimeRoot>$(PublishDir)$(AppHostRelativeDotNet)/</MnvtRuntimeRoot>
    </PropertyGroup>
    <Error Condition="!Exists('$(MnvtRuntimePack)')" Text="Runtime pack not found: $(MnvtRuntimePack)" />
    <ItemGroup>
      <MnvtFrameworkFile Include="$(MnvtRuntimePack)lib/$(TargetFramework)/*;$(MnvtRuntimePack)native/*" Exclude="$(MnvtRuntimePack)native/hostfxr.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(MnvtFrameworkFile)" DestinationFolder="$(MnvtRuntimeRoot)shared/Microsoft.NETCore.App/$(BundledNETCoreAppPackageVersion)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MnvtRuntimePack)native/hostfxr.dll" DestinationFolder="$(MnvtRuntimeRoot)host/fxr/$(BundledNETCoreAppPackageVersion)" SkipUnchangedFiles="true" />
  </Target>
</Project>
