<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dear ImGui backend (shared with the editor) and the in-game debug overlay: HUD, profiler, console, inspection panels
    and debug-draw rendering. Development-only: Release exports leave it out (see MNVTEngine.GameHost), and the build
    validator rejects it (and ImGui) in games that did not opt in.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ImGui.NET" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MNVTEngine.DebugUI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MNVTEngine.Runtime\MNVTEngine.Runtime.csproj" />
  </ItemGroup>
</Project>
