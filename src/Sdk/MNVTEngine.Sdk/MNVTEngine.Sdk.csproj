<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The gameplay SDK: a NuGet package bundling the engine's non-backend assemblies (with their XML docs) so a game
    project can compile against the engine API and get IntelliSense without a copy of the engine source. The game
    host ships the runtime copies, so a consumer references this package compile-only (ExcludeAssets="runtime").
    Backend and host assemblies (Graphics.Vulkan, Platform, DebugUI, *.Rendering, Runtime, host, …) are excluded.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>MNVTEngine.Sdk</PackageId>
    <Title>MNVTEngine Gameplay SDK</Title>
    <Description>The MNVTEngine gameplay API for game projects: compile-time references with IntelliSense docs. The game host provides these assemblies at run time, so reference this package compile-only (ExcludeAssets="runtime").</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- Every build refreshes the package in the engine's local feed, which game projects restore from. -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../../artifacts/nuget</PackageOutputPath>
    <!-- Engine assemblies are bundled into lib/ (below), not emitted as package dependencies. -->
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);BundleEngineAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- Public-API types the gameplay assemblies expose (e.g. JSON): a real package dependency for consumers. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <!--
    The gameplay engine assemblies, discovered automatically: every engine project is referenced, then the backend,
    host, rendering and development-tool projects are removed. A new gameplay module is picked up without editing this
    list; a new backend/host module is the only thing that needs a line added below. PrivateAssets=all: their outputs
    are bundled here (see BundleEngineAssemblies), not re-exported as package dependencies.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../Engine/**/MNVTEngine.*.csproj" PrivateAssets="all" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.Audio.OpenAL/MNVTEngine.Audio.OpenAL.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.Browser.Host/MNVTEngine.Browser.Host.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.CrashHandler/MNVTEngine.CrashHandler.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.DebugUI/MNVTEngine.DebugUI.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.GameAssemblies/MNVTEngine.GameAssemblies.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.GameHost/MNVTEngine.GameHost.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.Galaxy.Server/MNVTEngine.Galaxy.Server.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.Graphics.Vulkan/MNVTEngine.Graphics.Vulkan.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.Graphics.Vulkan.ShaderCompiler/MNVTEngine.Graphics.Vulkan.ShaderCompiler.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.Platform/MNVTEngine.Platform.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.Runtime/MNVTEngine.Runtime.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.World2D.Rendering/MNVTEngine.World2D.Rendering.csproj" />
    <ProjectReference Remove="$(MSBuildThisFileDirectory)../../Engine/MNVTEngine.World3D.Rendering/MNVTEngine.World3D.Rendering.csproj" />
  </ItemGroup>

  <Target Name="BundleEngineAssemblies">
    <ItemGroup>
      <!-- Backend/host assemblies that could appear transitively, and this façade: never shipped in the gameplay SDK. -->
      <_SdkExclude Include="
        $(OutputPath)MNVTEngine.Sdk.dll;$(OutputPath)MNVTEngine.Sdk.xml;
        $(OutputPath)MNVTEngine.Graphics.Vulkan.dll;$(OutputPath)MNVTEngine.Graphics.Vulkan.xml;
        $(OutputPath)MNVTEngine.Graphics.Vulkan.ShaderCompiler.dll;$(OutputPath)MNVTEngine.Graphics.Vulkan.ShaderCompiler.xml;
        $(OutputPath)MNVTEngine.Platform.dll;$(OutputPath)MNVTEngine.Platform.xml;
        $(OutputPath)MNVTEngine.DebugUI.dll;$(OutputPath)MNVTEngine.DebugUI.xml;
        $(OutputPath)MNVTEngine.World2D.Rendering.dll;$(OutputPath)MNVTEngine.World2D.Rendering.xml;
        $(OutputPath)MNVTEngine.World3D.Rendering.dll;$(OutputPath)MNVTEngine.World3D.Rendering.xml;
        $(OutputPath)MNVTEngine.Runtime.dll;$(OutputPath)MNVTEngine.Runtime.xml;
        $(OutputPath)MNVTEngine.Audio.OpenAL.dll;$(OutputPath)MNVTEngine.Audio.OpenAL.xml;
        $(OutputPath)MNVTEngine.GameAssemblies.dll;$(OutputPath)MNVTEngine.GameAssemblies.xml" />
      <TfmSpecificPackageFile Include="$(OutputPath)MNVTEngine.*.dll" Exclude="@(_SdkExclude)" PackagePath="lib/$(TargetFramework)/" />
      <TfmSpecificPackageFile Include="$(OutputPath)MNVTEngine.*.xml" Exclude="@(_SdkExclude)" PackagePath="lib/$(TargetFramework)/" />
    </ItemGroup>
  </Target>

</Project>
