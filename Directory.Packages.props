<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Engine -->
    <PackageVersion Include="Box2D.NET" Version="3.1.654" />
    <PackageVersion Include="ImGui.NET" Version="1.91.6.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Silk.NET.Input.Glfw" Version="2.23.0" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <!-- Model import (edit time only; exported games read artifacts): Assimp 6 for FBX (BSD-3, natives via Ultz.Native.Assimp), SharpGLTF for glTF (MIT) -->
    <PackageVersion Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageVersion Include="Silk.NET.Assimp" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageVersion Include="Vortice.VulkanMemoryAllocator" Version="1.8.0" />
    <PackageVersion Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
    <PackageVersion Include="StbTrueTypeSharp" Version="1.26.13" />
    <!-- Samples and tests -->
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
    <PackageVersion Include="StbImageWriteSharp" Version="1.16.7" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
