{
  "schemaVersion": 2,
  "name": "Browser2D",
  "profile": "2d",
  "startupScene": "Scenes/Main.mnvt",
  "window": { "title": "Browser2D", "width": 1280, "height": 720, "vSync": true, "resizable": true },
