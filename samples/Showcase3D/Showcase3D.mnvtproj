{
  "schemaVersion": 1,
  "name": "Showcase3D",
  "startupScene": "Scenes/Main.mnvt",
  "window": {
    "title": "MNVTEngine - Showcase3D",
    "width": 1280,
    "height": 720,
    "vSync": true,
    "resizable": true
  },
  "fixedTimestep": 0.016666668,
  "scripts": {
    "project": "Scripts/Showcase3D.Scripts.csproj"
  },
  "buildProfiles": [
    {
      "name": "debug",
      "configuration": "Debug",
      "target": "win-x64"
    },
    {
      "name": "release",
      "configuration": "Release",
      "target": "win-x64"
    }
  ]
}
